          "name": "Delete Object",
          "request": {
            "name": "Delete Object",
            "description": {
              "content": "Remove a vineyard object from memory by its ObjectID.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "objects",
                ":objectId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "force",
                  "value": "true",
                  "description": "Force deletion even if the object is referenced"
                },
                {
                  "disabled": false,
                  "key": "deep",
                  "value": "true",
                  "description": "Recursively delete member objects"
                }
              ],
              "variable": [
